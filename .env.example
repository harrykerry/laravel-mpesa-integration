APP_NAME="Laravel M-PESA Integration"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel_mpesa
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# Queues run on Redis by default. To use RabbitMQ instead, set
# QUEUE_CONNECTION=rabbitmq and fill in the RABBITMQ_* values below.
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
RABBITMQ_QUEUE=mpesa

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ---------------------------------------------------------------------------
# M-PESA (Safaricom Daraja)
# ---------------------------------------------------------------------------
# Everything the integration needs is read from config/mpesa.php, which reads
# the values below. Nothing here is ever accepted from an HTTP request.

MPESA_ENV=sandbox

MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=

# C2B (paybill / buy goods)
MPESA_C2B_SHORTCODE=
MPESA_C2B_RESPONSE_TYPE=Completed

# STK push (Lipa na M-PESA Online)
MPESA_STK_SHORTCODE=
MPESA_STK_PASSKEY=
MPESA_STK_PARTY_B=
MPESA_STK_TRANSACTION_TYPE=CustomerPayBillOnline
MPESA_STK_ACCOUNT_REFERENCE=Payment

# API operator used by the status, balance, reversal and payout APIs
MPESA_INITIATOR_NAME=
MPESA_SECURITY_CREDENTIAL=

# Payouts (B2C, B2B, tax remittance)
MPESA_PAYOUT_SHORTCODE=
MPESA_B2C_COMMAND_ID=BusinessPayment
MPESA_B2B_COMMAND_ID=BusinessPayBill

# Publicly reachable HTTPS URLs M-PESA calls back. No auth headers possible.
MPESA_CONFIRMATION_URL=
MPESA_VALIDATION_URL=
MPESA_STK_CALLBACK_URL=
MPESA_RESULT_URL=
MPESA_QUEUE_TIMEOUT_URL=

# Callback processing queue
MPESA_QUEUE_CONNECTION=
MPESA_QUEUE=mpesa
MPESA_QUEUE_TRIES=5
MPESA_QUEUE_TIMEOUT=30
MPESA_QUEUE_BACKOFF=10,30,60,300,900

# Forward confirmed payments on to another system (leave the URL unset to skip)
MPESA_FORWARD_URL=
MPESA_FORWARD_SECRET=

# C2B validation: reject a payment before M-PESA deducts the customer
MPESA_VALIDATION_ENABLED=true
MPESA_VALIDATION_REQUIRE_SHORTCODE=true
MPESA_VALIDATION_REQUIRE_BILL_REF=false
MPESA_VALIDATION_BILL_REF_PATTERN=
MPESA_VALIDATION_MIN_AMOUNT=
MPESA_VALIDATION_MAX_AMOUNT=

# Outbound HTTP
MPESA_HTTP_TIMEOUT=30
MPESA_HTTP_CONNECT_TIMEOUT=10
MPESA_HTTP_RETRIES=2
MPESA_HTTP_RETRY_DELAY=500

# Logging (the dedicated 'mpesa' channel in config/logging.php)
MPESA_LOG_DRIVER=daily
MPESA_LOG_LEVEL=debug
MPESA_LOG_DAYS=30

VITE_APP_NAME="${APP_NAME}"
